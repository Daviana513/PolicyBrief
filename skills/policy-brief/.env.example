# Local policy files. Relative paths are resolved from POLICYBRIEF_PROJECT_ROOT.
POLICYBRIEF_PROJECT_ROOT=.
POLICYBRIEF_KB_DIR=knowledge-base
# Optional explicit paths; omit these to use <KB_DIR>/policies.csv and policy_claims.csv.
# POLICYBRIEF_POLICY_CSV=data/policies.csv
# POLICYBRIEF_CLAIM_CSV=data/policy_claims.csv

# Use canonical for the English schema in references/schema.md, or zh for the
# compatible Chinese field set used by the Taiwan-policy example project.
POLICYBRIEF_FIELD_PROFILE=canonical
POLICYBRIEF_REQUEST_TIMEOUT_MS=20000
POLICYBRIEF_TIMEZONE_OFFSET=+08:00

# Notion is the recommended remote knowledge base. Create an internal
# integration, connect it to a parent page, and keep the token private.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxx
NOTION_PARENT_PAGE_ID=
NOTION_POLICY_DATA_SOURCE_ID=
NOTION_CLAIM_DATA_SOURCE_ID=
NOTION_POLICY_DATABASE_NAME=Policy records
NOTION_CLAIM_DATABASE_NAME=Policy claims

# Feishu self-built application credentials. Never commit the completed file.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_with_your_secret
FEISHU_BITABLE_APP_TOKEN=replace_with_your_base_token

# The policy table must already exist. The claim table ID is optional: the
# script can discover it by name, or create it only when `prepare` is run.
FEISHU_POLICY_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_CLAIM_TABLE_ID=
FEISHU_POLICY_TABLE_NAME=Policy records
FEISHU_CLAIM_TABLE_NAME=Policy claims
